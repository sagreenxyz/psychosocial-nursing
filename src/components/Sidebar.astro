---
export interface SidebarLesson {
  title: string;
  href: string;
  duration?: string;
}

export interface SidebarModule {
  title: string;
  slug: string;
  href: string;
  lessons: SidebarLesson[];
}

export interface Props {
  modules: SidebarModule[];
  currentHref: string;
}

const { modules, currentHref } = Astro.props;
---

<aside class="w-64 shrink-0 hidden lg:block">
  <div class="sticky top-20 bg-white rounded-xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="px-4 py-3 bg-gradient-to-r from-teal-500 to-primary-600">
      <h2 class="text-sm font-semibold text-white">Course Contents</h2>
    </div>
    <nav class="p-2 max-h-[calc(100vh-10rem)] overflow-y-auto">
      {modules.map((mod) => (
        <div class="mb-2">
          <a
            href={mod.href}
            class={`sidebar-link font-semibold text-xs uppercase tracking-wide ${
              currentHref === mod.href ? 'active' : ''
            }`}
          >
            {mod.title}
          </a>
          {mod.lessons.length > 0 && (
            <ul class="ml-4 mt-1 space-y-0.5">
              {mod.lessons.map((lesson) => (
                <li>
                  <a
                    href={lesson.href}
                    class={`sidebar-link text-xs ${currentHref === lesson.href ? 'active' : ''}`}
                  >
                    <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span class="truncate">{lesson.title}</span>
                    {lesson.duration && (
                      <span class="ml-auto text-slate-400 shrink-0">{lesson.duration}</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </nav>
  </div>
</aside>
