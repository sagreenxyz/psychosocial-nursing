---
const footerLinks = {
  'Course': [
    { href: '/', label: 'Home' },
    { href: '/modules', label: 'All Modules' },
    { href: '/syllabus', label: 'Syllabus' },
    { href: '/resources', label: 'Resources' },
  ],
  'Topics': [
    { href: '/modules/therapeutic-communication', label: 'Therapeutic Communication' },
    { href: '/modules/mental-health-assessment', label: 'Mental Health Assessment' },
    { href: '/modules/crisis-intervention', label: 'Crisis Intervention' },
    { href: '/modules/cultural-considerations', label: 'Cultural Considerations' },
  ],
};
---

<footer class="bg-slate-800 text-slate-300 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-teal-400 to-primary-500 flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <div>
            <span class="font-bold text-white text-sm block">Psychosocial Nursing</span>
            <span class="text-xs text-teal-400">Open Learning System</span>
          </div>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed max-w-sm">
          An open educational resource designed to support nursing students and professionals
          in understanding the psychosocial dimensions of patient care.
        </p>
      </div>

      <!-- Footer Links -->
      {Object.entries(footerLinks).map(([section, links]) => (
        <div>
          <h4 class="text-sm font-semibold text-white mb-3 uppercase tracking-wide">{section}</h4>
          <ul class="space-y-2">
            {links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-slate-400 hover:text-white transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 pt-8 border-t border-slate-700 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-slate-500">
        © {new Date().getFullYear()} Psychosocial Nursing LMS. Open Educational Resource.
      </p>
      <div class="flex items-center gap-4">
        <span class="text-xs text-slate-500">Built with</span>
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer"
          class="text-xs text-teal-400 hover:text-teal-300 transition-colors font-medium">
          Astro
        </a>
      </div>
    </div>
  </div>
</footer>
