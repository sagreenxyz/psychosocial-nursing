---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';

export interface Props {
  title: string;
  description?: string;
  moduleTitle: string;
  moduleSlug: string;
  prevLesson?: { title: string; href: string };
  nextLesson?: { title: string; href: string };
  readTime?: string;
  objectives?: string[];
  // MDX passes all frontmatter via `frontmatter` prop
  frontmatter?: {
    title: string;
    description?: string;
    moduleTitle: string;
    moduleSlug: string;
    prevLesson?: { title: string; href: string };
    nextLesson?: { title: string; href: string };
    readTime?: string;
    objectives?: string[];
  };
}

// Support both direct props (from .astro parents) and frontmatter props (from MDX)
const fm = Astro.props.frontmatter ?? {};
const title = Astro.props.title ?? fm.title;
const description = Astro.props.description ?? fm.description;
const moduleTitle = Astro.props.moduleTitle ?? fm.moduleTitle;
const moduleSlug = Astro.props.moduleSlug ?? fm.moduleSlug;
const prevLesson = Astro.props.prevLesson ?? fm.prevLesson;
const nextLesson = Astro.props.nextLesson ?? fm.nextLesson;
const readTime = Astro.props.readTime ?? fm.readTime ?? '10 min';
const objectives: string[] = Astro.props.objectives ?? fm.objectives ?? [];

const currentHref = Astro.url.pathname;

// Static sidebar modules — update when adding new content
const sidebarModules = [
  {
    title: 'Module 1: Foundations',
    slug: 'foundations',
    href: '/modules/foundations',
    lessons: [
      { title: 'What Is Psychosocial Nursing?', href: '/modules/foundations/what-is-psychosocial-nursing', duration: '8 min' },
      { title: 'Holistic Patient Assessment', href: '/modules/foundations/holistic-assessment', duration: '10 min' },
      { title: 'Therapeutic Relationship', href: '/modules/foundations/therapeutic-relationship', duration: '12 min' },
    ],
  },
  {
    title: 'Module 2: Communication',
    slug: 'therapeutic-communication',
    href: '/modules/therapeutic-communication',
    lessons: [
      { title: 'Principles of Therapeutic Communication', href: '/modules/therapeutic-communication/principles', duration: '10 min' },
      { title: 'Active Listening Techniques', href: '/modules/therapeutic-communication/active-listening', duration: '8 min' },
      { title: 'Non-Verbal Communication', href: '/modules/therapeutic-communication/non-verbal', duration: '7 min' },
      { title: 'Barriers to Communication', href: '/modules/therapeutic-communication/barriers', duration: '9 min' },
    ],
  },
  {
    title: 'Module 3: Mental Health Assessment',
    slug: 'mental-health-assessment',
    href: '/modules/mental-health-assessment',
    lessons: [
      { title: 'Mental Status Examination', href: '/modules/mental-health-assessment/mental-status-exam', duration: '12 min' },
      { title: 'Risk Assessment', href: '/modules/mental-health-assessment/risk-assessment', duration: '10 min' },
    ],
  },
  {
    title: 'Module 4: Crisis Intervention',
    slug: 'crisis-intervention',
    href: '/modules/crisis-intervention',
    lessons: [
      { title: 'Crisis Theory and Models', href: '/modules/crisis-intervention/crisis-theory', duration: '10 min' },
      { title: 'De-escalation Strategies', href: '/modules/crisis-intervention/de-escalation', duration: '11 min' },
    ],
  },
  {
    title: 'Module 5: Cultural Care',
    slug: 'cultural-considerations',
    href: '/modules/cultural-considerations',
    lessons: [
      { title: 'Culturally Competent Care', href: '/modules/cultural-considerations/culturally-competent-care', duration: '9 min' },
      { title: 'Implicit Bias in Nursing', href: '/modules/cultural-considerations/implicit-bias', duration: '8 min' },
    ],
  },
];
---

<BaseLayout title={title} description={description}>
  <Header />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex gap-8 flex-1">
    <!-- Sidebar -->
    <Sidebar modules={sidebarModules} currentHref={currentHref} />

    <!-- Main Content -->
    <main class="flex-1 min-w-0">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-slate-500 mb-6">
        <a href="/modules" class="hover:text-primary-600 transition-colors">Modules</a>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <a href={`/modules/${moduleSlug}`} class="hover:text-primary-600 transition-colors truncate">
          {moduleTitle}
        </a>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-slate-700 truncate">{title}</span>
      </nav>

      <article class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
        <!-- Article Header -->
        <div class="px-8 py-8 border-b border-slate-100 bg-gradient-to-br from-slate-50 to-white">
          <div class="flex items-center gap-3 mb-3">
            <span class="module-badge bg-primary-50 text-primary-700">{moduleTitle}</span>
            <span class="flex items-center gap-1 text-xs text-slate-400">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {readTime} read
            </span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-bold text-slate-800">{title}</h1>
          {description && <p class="mt-2 text-slate-500 leading-relaxed">{description}</p>}

          <!-- Learning Objectives -->
          {objectives.length > 0 && (
            <div class="mt-5 p-4 bg-teal-50 border border-teal-100 rounded-lg">
              <h3 class="text-sm font-semibold text-teal-800 mb-2 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                </svg>
                Learning Objectives
              </h3>
              <ul class="space-y-1.5">
                {objectives.map((obj) => (
                  <li class="flex items-start gap-2 text-sm text-teal-700">
                    <svg class="w-4 h-4 text-teal-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd"
                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                        clip-rule="evenodd" />
                    </svg>
                    {obj}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <!-- Article Body -->
        <div class="px-8 py-8 prose-nursing">
          <slot />
        </div>

        <!-- Navigation -->
        <div class="px-8 py-6 border-t border-slate-100 bg-slate-50 flex items-center justify-between gap-4">
          {prevLesson ? (
            <a href={prevLesson.href} class="btn-secondary text-sm group">
              <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              <span class="hidden sm:inline">{prevLesson.title}</span>
              <span class="sm:hidden">Previous</span>
            </a>
          ) : (
            <div></div>
          )}
          {nextLesson ? (
            <a href={nextLesson.href} class="btn-primary text-sm group ml-auto">
              <span class="hidden sm:inline">{nextLesson.title}</span>
              <span class="sm:hidden">Next</span>
              <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          ) : (
            <div></div>
          )}
        </div>
      </article>
    </main>
  </div>

  <Footer />
</BaseLayout>
