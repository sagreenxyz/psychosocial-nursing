---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const lessons = [
  {
    title: 'Principles of Therapeutic Communication',
    href: '/modules/therapeutic-communication/principles',
    duration: '10 min',
    description: 'Explore the core principles that underpin effective nurse-patient communication.',
  },
  {
    title: 'Active Listening Techniques',
    href: '/modules/therapeutic-communication/active-listening',
    duration: '8 min',
    description: 'Practice verbal and non-verbal techniques that demonstrate genuine listening and empathy.',
  },
  {
    title: 'Non-Verbal Communication',
    href: '/modules/therapeutic-communication/non-verbal',
    duration: '7 min',
    description: 'Understand how body language, proxemics, and tone of voice shape therapeutic interactions.',
  },
  {
    title: 'Barriers to Communication',
    href: '/modules/therapeutic-communication/barriers',
    duration: '9 min',
    description: 'Identify common communication blocks and develop strategies to overcome them.',
  },
];
---

<BaseLayout title="Module 2: Therapeutic Communication">
  <Header />
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="flex items-center gap-2 text-sm text-slate-500 mb-6">
      <a href="/" class="hover:text-primary-600 transition-colors">Home</a>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <a href="/modules" class="hover:text-primary-600 transition-colors">Modules</a>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <span class="text-slate-700">Therapeutic Communication</span>
    </nav>

    <div class="bg-gradient-to-br from-blue-500 to-blue-700 rounded-2xl p-8 text-white mb-8 relative overflow-hidden">
      <div class="absolute -top-6 -right-6 w-40 h-40 bg-white/10 rounded-full"></div>
      <div class="absolute -bottom-10 -left-10 w-36 h-36 bg-white/10 rounded-full"></div>
      <div class="relative">
        <span class="text-5xl block mb-3">💬</span>
        <div class="flex items-center gap-2 mb-2">
          <span class="px-2 py-0.5 bg-white/20 rounded text-xs font-medium">Module 02</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold">Therapeutic Communication</h1>
        <p class="mt-3 text-blue-100 max-w-xl leading-relaxed">
          Communication is the primary tool of nursing practice. This module develops your
          ability to engage patients with empathy, precision, and therapeutic intent.
        </p>
        <div class="flex flex-wrap gap-4 mt-5 text-sm text-blue-200">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            4 Lessons
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            ~34 min total
          </span>
        </div>
      </div>
    </div>

    <h2 class="text-lg font-bold text-slate-800 mb-4">Lessons in this Module</h2>
    <div class="space-y-3">
      {lessons.map((lesson, i) => (
        <a href={lesson.href} class="card flex items-center gap-5 p-5 group">
          <div class="w-10 h-10 rounded-full bg-blue-50 border-2 border-blue-200 text-blue-700 font-bold flex items-center justify-center shrink-0 text-sm group-hover:bg-blue-100 transition-colors">
            {i + 1}
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="font-semibold text-slate-800 group-hover:text-primary-700 transition-colors">{lesson.title}</h3>
            <p class="text-sm text-slate-500 mt-0.5 truncate">{lesson.description}</p>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <span class="text-xs text-slate-400 hidden sm:block">{lesson.duration}</span>
            <svg class="w-5 h-5 text-slate-300 group-hover:text-primary-500 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))}
    </div>
    <div class="mt-8 text-center">
      <a href="/modules/therapeutic-communication/principles" class="btn-primary">Start Module 2 →</a>
    </div>
  </main>
  <Footer />
</BaseLayout>
